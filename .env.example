# ==============================================================================
# Multi-Tenant Clinic Management & Patient Booking SaaS - Environment Config
# ==============================================================================

# Supabase / PostgreSQL Database Connection
# Use Supabase Connection Pooler (port 6543) for DATABASE_URL with pgbouncer=true
# Use Direct Connection (port 5432) for DIRECT_URL (Prisma migrations)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application Settings
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-clinic-saas-production-quality-minimum-32-chars"
SESSION_EXPIRY_DAYS="7"

# Notification Providers (Development Adapter used when keys missing)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@clinicflow.in"

WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Currency & Locale Defaults
DEFAULT_CURRENCY="INR"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_LOCALE="en-IN"
