datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. IDENTITY, TENANCY & RBAC
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  DOCTOR
  RECEPTIONIST
  CASHIER
  PHARMACIST
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  avatarUrl     String?
  isSuperAdmin  Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   ClinicMembership[]
  sessions      Session[]
  auditLogs     PlatformAuditLog[]

  @@map("users")
}

model Clinic {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  clinicType      String    @default("General Clinic")
  description     String?
  address         String
  city            String
  state           String
  pinCode         String
  phone           String
  email           String
  logoUrl         String?
  coverUrl        String?
  brandColor      String    @default("#0d9488")
  timezone        String    @default("Asia/Kolkata")
  currency        String    @default("INR")
  isVerified      Boolean   @default(false)
  isPublished     Boolean   @default(false)
  bookingEnabled  Boolean   @default(true)
  customDomain    String?   @unique
  cancellationHours Int     @default(2)
  bufferMinutes   Int       @default(5)
  defaultSlotMinutes Int    @default(15)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     ClinicMembership[]
  doctors         Doctor[]
  hours           ClinicHour[]
  holidays        ClinicHoliday[]
  services        ClinicService[]
  patients        Patient[]
  appointments    Appointment[]
  queueEntries    QueueEntry[]
  invoices        Invoice[]
  payments        Payment[]
  refunds         Refund[]
  medicines       Medicine[]
  medicineCategories MedicineCategory[]
  suppliers       Supplier[]
  inventoryBatches InventoryBatch[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  subscription    ClinicSubscription?

  @@index([city])
  @@index([pinCode])
  @@index([isPublished, bookingEnabled])
  @@map("clinics")
}

model ClinicMembership {
  id        String   @id @default(uuid())
  clinicId  String
  userId    String
  role      UserRole @default(RECEPTIONIST)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([clinicId, role])
  @@map("clinic_memberships")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 2. CLINIC HOURS, SPECIALTIES & DOCTORS
// -----------------------------------------------------------------------------

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  doctors     Doctor[]

  @@map("specialties")
}

model ClinicHour {
  id        String   @id @default(uuid())
  clinicId  String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  String   // "09:00"
  closeTime String   // "18:00"
  isClosed  Boolean  @default(false)

  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_hours")
}

model Doctor {
  id                 String    @id @default(uuid())
  clinicId           String
  userId             String?
  name               String
  email              String?
  phone              String?
  specialtyId        String?
  specialtyName      String    @default("General Medicine")
  qualifications     String    // e.g. "MBBS, MD"
  registrationNumber String?   // Medical Council Reg No
  consultationFee    Decimal   @default(500) @db.Decimal(10, 2)
  bio                String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty          Specialty? @relation(fields: [specialtyId], references: [id])
  schedules          DoctorSchedule[]
  blockedSlots       BlockedSlot[]
  appointments       Appointment[]

  @@index([clinicId, isActive])
  @@map("doctors")
}

model DoctorSchedule {
  id                 String   @id @default(uuid())
  doctorId           String
  dayOfWeek          Int      // 0 - 6
  startTime          String   // "09:00"
  endTime            String   // "13:00"
  slotDurationMinutes Int     @default(15)
  maxPatientsPerSlot Int      @default(1)
  isDayOff           Boolean  @default(false)

  doctor             Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("doctor_schedules")
}

model BlockedSlot {
  id        String   @id @default(uuid())
  clinicId  String
  doctorId  String?
  date      DateTime @db.Date
  startTime String   // "10:00"
  endTime   String   // "11:00"
  reason    String?

  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, date])
  @@map("blocked_slots")
}

model ClinicHoliday {
  id        String   @id @default(uuid())
  clinicId  String
  date      DateTime @db.Date
  title     String

  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@map("clinic_holidays")
}

model ClinicService {
  id              String   @id @default(uuid())
  clinicId        String
  name            String
  description     String?
  durationMinutes Int      @default(15)
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, isActive])
  @@map("clinic_services")
}

// -----------------------------------------------------------------------------
// 3. PATIENTS, APPOINTMENTS & QUEUE
// -----------------------------------------------------------------------------

model Patient {
  id          String    @id @default(uuid())
  clinicId    String
  fullName    String
  phone       String
  email       String?
  gender      String?   // "Male", "Female", "Other"
  dateOfBirth DateTime? @db.Date
  bloodGroup  String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices    Invoice[]
  queueEntries QueueEntry[]

  @@unique([clinicId, phone])
  @@index([clinicId, fullName])
  @@map("patients")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                 String            @id @default(uuid())
  clinicId           String
  patientId          String
  doctorId           String
  reference          String            @unique // e.g. "APT-9F42A1"
  date               DateTime          @db.Date
  startTime          String            // "10:00"
  endTime            String            // "10:15"
  status             AppointmentStatus @default(CONFIRMED)
  consultationFee    Decimal           @db.Decimal(10, 2)
  reason             String?
  staffNotes         String?
  bookedOnline       Boolean           @default(false)
  cancellationReason String?
  cancelledAt        DateTime?
  rescheduledFromId  String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  queueEntry         QueueEntry?
  statusLogs         AppointmentStatusLog[]

  @@index([clinicId, date, status])
  @@index([clinicId, doctorId, date])
  @@index([patientId])
  @@map("appointments")
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model QueueEntry {
  id                 String      @id @default(uuid())
  clinicId           String
  appointmentId      String?     @unique
  patientId          String
  tokenNumber        Int
  date               DateTime    @db.Date
  status             QueueStatus @default(WAITING)
  checkedInAt        DateTime    @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  estimatedWaitMins  Int         @default(15)

  clinic             Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient            Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date, tokenNumber])
  @@index([clinicId, date, status])
  @@map("queue_entries")
}

model AppointmentStatusLog {
  id            String            @id @default(uuid())
  appointmentId String
  fromStatus    AppointmentStatus
  toStatus      AppointmentStatus
  changedBy     String?
  notes         String?
  createdAt     DateTime          @default(now())

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_logs")
}

// -----------------------------------------------------------------------------
// 4. BILLING, PAYMENTS & REFUNDS (INR DECIMAL-SAFE)
// -----------------------------------------------------------------------------

enum InvoiceType {
  CONSULTATION
  PHARMACY
  COMBINED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  REFUNDED
}

model Invoice {
  id                String        @id @default(uuid())
  clinicId          String
  patientId         String?
  appointmentId     String?
  invoiceNumber     String        // e.g. "INV-2026-0001"
  type              InvoiceType   @default(CONSULTATION)
  status            InvoiceStatus @default(ISSUED)
  subtotal          Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(10, 2)
  outstandingAmount Decimal       @default(0) @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  clinic            Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient?      @relation(fields: [patientId], references: [id])
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  refunds           Refund[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, status])
  @@index([clinicId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  medicineId  String?
  batchId     String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  SUCCESS
  REFUNDED
  VOID
}

model Payment {
  id               String        @id @default(uuid())
  clinicId         String
  invoiceId        String
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod @default(CASH)
  reference        String?       // UPI Ref / Card Txn ID
  status           PaymentStatus @default(SUCCESS)
  notes            String?
  recordedByUserId String?
  createdAt        DateTime      @default(now())

  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds          Refund[]

  @@index([clinicId, createdAt])
  @@map("payments")
}

model Refund {
  id                 String   @id @default(uuid())
  clinicId           String
  paymentId          String
  invoiceId          String
  amount             Decimal  @db.Decimal(10, 2)
  reason             String
  authorizedByUserId String?
  createdAt          DateTime @default(now())

  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  payment            Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("refunds")
}

// -----------------------------------------------------------------------------
// 5. PHARMACY & INVENTORY (BATCH TRACKING, FEFO, AUDITABLE LEDGER)
// -----------------------------------------------------------------------------

model MedicineCategory {
  id          String     @id @default(uuid())
  clinicId    String
  name        String
  description String?

  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medicines   Medicine[]

  @@unique([clinicId, name])
  @@map("medicine_categories")
}

model Medicine {
  id                     String            @id @default(uuid())
  clinicId               String
  name                   String
  brand                  String?
  genericName            String?
  categoryId             String?
  dosageForm             String            @default("Tablet") // Tablet, Syrup, Injection, Capsule, Ointment
  strength               String?           // e.g. "500mg"
  barcode                String?
  uom                    String            @default("Strip") // Strip, Bottle, Box, Vial
  purchasePrice          Decimal           @default(0) @db.Decimal(10, 2)
  sellingPrice           Decimal           @db.Decimal(10, 2)
  reorderThreshold       Int               @default(10)
  taxPercent             Decimal           @default(0) @db.Decimal(5, 2)
  isPrescriptionRequired Boolean           @default(false)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  clinic                 Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category               MedicineCategory? @relation(fields: [categoryId], references: [id])
  batches                InventoryBatch[]
  movements              StockMovement[]

  @@index([clinicId, name])
  @@index([clinicId, barcode])
  @@map("medicines")
}

model Supplier {
  id            String          @id @default(uuid())
  clinicId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  batches       InventoryBatch[]
  purchaseOrders PurchaseOrder[]

  @@index([clinicId, name])
  @@map("suppliers")
}

model InventoryBatch {
  id               String          @id @default(uuid())
  clinicId         String
  medicineId       String
  batchNumber      String
  expiryDate       DateTime        @db.Date
  purchaseCost     Decimal         @db.Decimal(10, 2)
  sellingPrice     Decimal         @db.Decimal(10, 2)
  quantityReceived Int
  currentStock     Int
  supplierId       String?
  receivedDate     DateTime        @default(now()) @db.Date
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  clinic           Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medicine         Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  movements        StockMovement[]

  @@unique([clinicId, medicineId, batchNumber])
  @@index([clinicId, expiryDate])
  @@index([clinicId, currentStock])
  @@map("inventory_batches")
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_DAMAGE
  ADJUSTMENT_EXPIRED
  AUDIT_CORRECTION
}

model StockMovement {
  id               String            @id @default(uuid())
  clinicId         String
  medicineId       String
  batchId          String?
  type             StockMovementType
  quantity         Int               // Positive for stock in, negative for stock out
  balanceAfter     Int
  referenceType    String?           // "INVOICE", "PURCHASE_ORDER", "MANUAL"
  referenceId      String?
  reason           String?
  recordedByUserId String?
  createdAt        DateTime          @default(now())

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch            InventoryBatch?   @relation(fields: [batchId], references: [id])

  @@index([clinicId, medicineId, createdAt])
  @@index([clinicId, batchId])
  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  clinicId    String
  supplierId  String
  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @default(0) @db.Decimal(10, 2)
  notes       String?
  orderDate   DateTime            @default(now()) @db.Date
  receivedDate DateTime?          @db.Date
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  clinic      Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@unique([clinicId, orderNumber])
  @@index([clinicId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  medicineId       String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(10, 2)
  totalCost        Decimal       @db.Decimal(10, 2)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

// -----------------------------------------------------------------------------
// 6. SAAS SUPER ADMIN, PLANS & AUDIT
// -----------------------------------------------------------------------------

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  CLINIC_PLUS
}

model SubscriptionPlan {
  id                     String           @id @default(uuid())
  name                   String
  tier                   SubscriptionTier @unique
  monthlyPrice           Decimal          @db.Decimal(10, 2)
  annualPrice            Decimal          @db.Decimal(10, 2)
  trialDays              Int              @default(14)
  maxDoctors             Int              @default(2)
  maxStaff               Int              @default(5)
  maxAppointmentsMonthly Int              @default(300)
  features               String[]
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())

  subscriptions          ClinicSubscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model ClinicSubscription {
  id                 String             @id @default(uuid())
  clinicId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  suspensionReason   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  clinic             Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("clinic_subscriptions")
}

model PlatformAuditLog {
  id          String   @id @default(uuid())
  clinicId    String?
  userId      String?
  action      String   // e.g. "CLINIC_SUSPENDED", "PLAN_CHANGED", "REFUND_ISSUED"
  entityType  String
  entityId    String?
  ipAddress   String?
  detailsJson String?  // JSON stringified details
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([clinicId, createdAt])
  @@index([action])
  @@map("platform_audit_logs")
}

model NotificationLog {
  id               String   @id @default(uuid())
  clinicId         String?
  recipient        String
  channel          String   // EMAIL, WHATSAPP, SMS
  eventType        String   // BOOKING_CONFIRMED, REMINDER, etc.
  status           String   // SENT, FAILED, SIMULATED
  providerResponse String?
  createdAt        DateTime @default(now())

  @@index([clinicId, eventType])
  @@map("notification_logs")
}
